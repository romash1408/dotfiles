#!/bin/bash

# Keep a working forwarded agent across short-lived SSH sessions.
# A new session's temporary socket disappears when that session closes.
if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ] &&
   [ ! -S "$HOME/.ssh/ssh_auth_sock" ]; then
   ln -sfn "$SSH_AUTH_SOCK" "$HOME/.ssh/ssh_auth_sock"
fi
