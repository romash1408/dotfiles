# chezmoi modify_: reaper.ini целиком не храним (в нём окна, пути, кэши машины),
# правим только свои ключи в секции [reaper]; остальное пропускаем как есть.
#
# midiins* — битовые маски по ID MIDI-устройства (_h/_x/_x_h — следующие блоки
# по 32 ID). -1 = включены все слоты, в том числе ещё не занятые: любая новая
# клавиатура попадает во включённый слот и сразу играет, без настройки.
#   midiins        вход для записи дорожек
#   midiins_all    участвует в «All MIDI inputs» (вход дорожек шаблона)
#   midiins_cs     управляющие сообщения (фейдеры → действия, Learn)
#   midiins_nowarn не ругаться окном на отсутствующее устройство при старте
# Reaper пишет ini при выходе: применять, когда он закрыт.
awk '
BEGIN {
  n = split("midiins midiins_all midiins_cs midiins_nowarn", base, " ")
  split(" _h _x _x_h", suf, " ")
  k = 0
  for (i = 1; i <= n; i++) {
    want[base[i]] = "-1"; order[++k] = base[i]
    for (j = 1; j <= 3; j++) { key = base[i] suf[j]; want[key] = "-1"; order[++k] = key }
  }
}
function flush(   i) {
  for (i = 1; i <= k; i++) if (!(order[i] in done)) print order[i] "=" want[order[i]]
}
/^\[/ {
  if (insec) flush()
  insec = (tolower($0) == "[reaper]"); if (insec) seen = 1
  print; next
}
insec {
  eq = index($0, "=")
  if (eq > 0) { key = substr($0, 1, eq - 1); if (key in want) { print key "=" want[key]; done[key] = 1; next } }
}
{ print }
END {
  if (insec) flush()
  else if (!seen) { print "[reaper]"; flush() }
}
'
