[Unit]
Description=Ovis web UI (Herdr stays in its own service)
After=herdr.service

[Service]
Type=exec
ExecStart=%h/.local/bin/herdr-web-run
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
