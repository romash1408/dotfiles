{{- $herdr := lookPath "herdr" | default "/home/linuxbrew/.linuxbrew/bin/herdr" -}}
{{- $bin := dir $herdr -}}
[Unit]
Description=Herdr terminal workspace server (persistent AI-agent panes)
Documentation=https://herdr.dev
# Намеренно на default.target, а НЕ на graphical-session.target — даже на
# машинах с GUI.
#
# История. Пока сервер жил в session-scope, logind слал SIGHUP панелям раньше
# сервера, тот считал это "закрыт последний воркспейс" и делал persist.clear
# вместо persist.save — session.json стирался. Лечили связкой
# After/PartOf=graphical-session.target: она давала упорядоченную остановку
# с отработкой ExecStop.
#
# Почему привязку сняли (6 сен 2026). Сервер давно уехал из session-scope: он и
# все панели живут в cgroup user@1000.service/app.slice/herdr.service, а в
# session-<N>.scope остаются только sddm-helper, startplasma-x11 и ssh-agent —
# SIGHUP при разлогине до панелей не дотягивается (проверено, KillUserProcesses
# = false). PartOf при этом давал обратный эффект: выход из графики ОСТАНАВЛИВАЛ
# сервер вместе со всеми панелями и работавшими в них агентами. Теперь разлогин
# herdr не трогает — user@1000.service держится за счёт linger. Упорядоченную
# остановку с ExecStop даёт остановка user@1000.service при выключении и ребуте.
#
# НЕ ВОЗВРАЩАТЬ graphical-session.target "чтобы не терялись сессии": потеря была
# про session-scope, а не про target, и возврат снова начнёт убивать панели при
# каждом разлогине.

[Service]
Type=exec
ExecStart={{ $herdr }} server
# Штатная остановка через сокет: сервер сначала сохраняет session.json,
# и только потом гасит панели.
ExecStop={{ $herdr }} server stop
TimeoutStopSec=30
KillMode=mixed
# herdr завершается с кодом 0, когда закрыта последняя панель. При on-failure
# юнит ушёл бы в inactive, а следующий `herdr` поднял бы сервер снова внутри
# session-scope — и проблема с persist.clear вернулась бы.
Restart=always
RestartSec=2
# В session-scope у herdr был TasksMax=infinity, в юните он получает
# DefaultTasksMax (23657 на hp). См. herdrdev/herdr#3324: при упоре в TasksMax
# сервер падает по fork/EAGAIN и шлёт SIGHUP всем панелям, без ошибки в логе.
# Бэкстопом остаётся user-<uid>.slice.
TasksMax=infinity
Environment=PATH={{ $bin }}:%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin

[Install]
WantedBy=default.target
