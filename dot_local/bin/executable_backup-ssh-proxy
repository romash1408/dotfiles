#!/usr/bin/env python3
"""Reach backup through hp/LAN and luel's Tart NAT; no persistent tunnels."""
import os
import shlex
import socket
import sys

LAN_HP = '192.168.86.11'
LAN_LUEL = '192.168.86.195'


def main():
    if sys.argv[1:] == ['--available']:
        try:
            with socket.create_connection((LAN_HP, 22), timeout=0.5):
                pass
        except OSError:
            return 1
        return 0
    if sys.argv[1:]:
        raise SystemExit('Usage: backup-ssh-proxy [--available]')
    common = ['-T', '-o', 'BatchMode=yes', '-o', 'ForwardAgent=no',
              '-o', 'ClearAllForwardings=yes', '-o', 'StrictHostKeyChecking=yes',
              '-o', 'ConnectTimeout=5', '-o', 'ServerAliveInterval=15',
              '-o', 'ServerAliveCountMax=3']
    hp = shlex.join(['/usr/bin/ssh', *common,
                     '-o', 'HostName=' + LAN_HP, '-o', 'HostKeyAlias=hp',
                     'hp', '-W', LAN_LUEL + ':22'])
    # Query DHCP each time: the Tart guest address can change after a reboot.
    # nc's -G is a connect timeout, not an idle timeout for the SSH stream.
    remote = '''vm_ip=$(/opt/homebrew/bin/tart ip backup --wait 5) || exit 1
case "$vm_ip" in
  192.168.64.*) ;;
  *) echo "backup-ssh-proxy: unexpected or missing Tart NAT address" >&2; exit 1 ;;
esac
exec /usr/bin/nc -n -G 10 "$vm_ip" 22'''
    os.execv('/usr/bin/ssh', ['/usr/bin/ssh', *common,
                            '-o', 'HostName=' + LAN_LUEL,
                            '-o', 'ProxyCommand=' + hp, 'luel', remote])


if __name__ == '__main__':
    sys.exit(main())
