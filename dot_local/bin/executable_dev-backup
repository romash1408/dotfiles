#!/usr/bin/env python3
"""Pull dev recovery data to this Mac and keep encrypted restic snapshots."""
import argparse
import datetime
import fcntl
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tempfile
import time

HOME = Path.home()
BASE = HOME / 'Backups/dev'
STAGE = BASE / '.staging-v2'
CONFIG = HOME / '.config/dev-backup'
REPO = BASE / 'repository'
PASSWORD = CONFIG / 'password'
RESTIC = '/opt/homebrew/bin/restic'
RSYNC = '/opt/homebrew/bin/rsync'
SSH = ['ssh', '-o', 'ForwardAgent=no', '-o', 'ClearAllForwardings=yes', '-o', 'BatchMode=yes',
       '-o', 'ConnectTimeout=15', '-o', 'ServerAliveInterval=15', '-o', 'ServerAliveCountMax=3', 'dev']



def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def run(args, **kwargs):
    print(now(), shlex.join([str(x) for x in args]), flush=True)
    return subprocess.run([str(x) for x in args], check=True, **kwargs)


def restic(*args, **kwargs):
    return run([RESTIC, '-r', REPO, '-p', PASSWORD, '--retry-lock', '2m', *args], **kwargs)


def save_status(value):
    CONFIG.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Primary and daily archive jobs have different job locks, but share status.
    with (CONFIG / 'status.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = CONFIG / 'status.json'
        old = json.loads(path.read_text()) if path.exists() else {}
        old.update(value)
        fd, temporary = tempfile.mkstemp(dir=CONFIG)
        with os.fdopen(fd, 'w') as f:
            json.dump(old, f, ensure_ascii=False, indent=2)
            f.write('\n')
        os.replace(temporary, path)


def sync(source, destination, files=None, excludes=(), directory_links=False):
    destination.mkdir(parents=True, exist_ok=True, mode=0o700)
    args = [RSYNC, '-azr', '--compress-choice=zstd', '--no-owner', '--no-group', '--timeout=120', '--delete', '--stats',
            '-e', shlex.join(SSH[:-1])]
    if directory_links:
        args.append('--copy-dirlinks')
    args.extend('--exclude=' + x for x in excludes)
    if files is not None:
        with tempfile.NamedTemporaryFile(dir=CONFIG) as f:
            f.write(''.join(x + '\n' for x in files).encode())
            f.flush()
            run([*args, '--relative', '--files-from=' + f.name, source, destination])
    else:
        run([*args, source, destination])


def snapshot(tag, paths=None):
    recovery = STAGE / 'recovery'
    recovery.mkdir(exist_ok=True)
    shutil.copy2(Path(__file__).resolve(), recovery / 'dev-backup')
    guide = HOME / '.local/share/dev-backup/RECOVERY.md'
    if guide.exists():
        shutil.copy2(guide, recovery / 'RECOVERY.md')
    restore_script = HOME / '.local/libexec/dev-backup/restore-worktree.py'
    if restore_script.exists():
        shutil.copy2(restore_script, recovery / 'restore-worktree.py')
    prepare = HOME / '.local/libexec/dev-backup/prepare-recovery.py'
    if prepare.exists():
        shutil.copy2(prepare, recovery / 'prepare-recovery.py')
    verify = HOME / '.local/libexec/dev-backup/verify-sessions.py'
    if verify.exists():
        shutil.copy2(verify, recovery / 'verify-sessions.py')
    p = restic('backup', *(paths or ['home', 'recovery']), '--host', 'dev', '--tag', tag, '--tag', 'managed-codex', '--json',
               cwd=STAGE, capture_output=True, text=True)
    lines = [json.loads(x) for x in p.stdout.splitlines() if x.strip()]
    summary = next(x for x in reversed(lines) if x.get('message_type') == 'summary')
    print(json.dumps(summary), flush=True)
    if p.stderr:
        print(p.stderr, file=sys.stderr)
    return summary


def preserve_partial(error):
    manifest = STAGE / 'recovery/manifest.json'
    status_path = CONFIG / 'status.json'
    if not manifest.exists() or not json.loads(status_path.read_text()).get('capture_received'):
        return
    value = json.loads(manifest.read_text())
    value['complete'] = False
    value.setdefault('transfer_errors', []).append(str(error))
    manifest.write_text(json.dumps(value, ensure_ascii=False, indent=2) + '\n')
    for name in ['home']:
        (STAGE / name).mkdir(exist_ok=True)
    try:
        summary = snapshot('partial')
        save_status({'last_partial_snapshot': summary['snapshot_id'], 'last_partial_at': now()})
    except Exception as e:
        print('Could not preserve partial snapshot:', e, file=sys.stderr)


def backup():
    if not PASSWORD.exists() or not (REPO / 'config').exists():
        raise RuntimeError('Initialize the repository and private password file before enabling the timer')
    if shutil.disk_usage(BASE).free < 25 * 1024**3:
        raise RuntimeError('Less than 25 GiB free; keeping previous snapshots and stopping')
    save_status({'last_attempt': now(), 'running': True, 'error': None,
                 'capture_received': False, 'backup_schema': 2, 'scope': 'managed-codex-recovery',
                 'archive_enabled': False, 'archive_running': False, 'archive_error': None})
    collector = HOME / '.local/libexec/dev-backup/collect.py'
    worker = "import sys; SOURCE_CODE=sys.stdin.read(); exec(compile(SOURCE_CODE, '<dev-backup-collector>', 'exec'))"
    p = run([*SSH, 'python3 -c ' + shlex.quote(worker)], input=collector.read_bytes(), capture_output=True, timeout=1800)
    result = json.loads(p.stdout)
    remote = result['run_dir']
    source_home = result['manifest']['source_home']
    import re
    if not re.fullmatch(re.escape(source_home + '/.cache/dev-backup/run-') + '[0-9a-f]{32}', remote):
        raise RuntimeError('Unexpected collector output path')
    try:
        # Only immutable selected export data is copied; live HOME is never mirrored.
        sync('dev:' + remote + '/recovery/', STAGE / 'recovery')
        save_status({'capture_received': True})
        sync('dev:' + remote + '/home/', STAGE / 'home')
        manifest = result['manifest']
        summary = snapshot('complete' if manifest['complete'] else 'partial')
        values = {'running': False, 'capture_received': False,
                  'last_snapshot': summary['snapshot_id'], 'last_snapshot_at': now(),
                  'arc_worktrees': len(manifest['arc_exports']), 'databases': len(manifest['databases']),
                  'managed_agents': manifest['managed_agents'], 'sessions': len(manifest['sessions']),
                  'history_records': manifest['history_records'], 'warnings': manifest['warnings'],
                  'errors': manifest['errors'], 'error': None}
        if manifest['complete']:
            values.update(last_success=now(), last_complete_snapshot=summary['snapshot_id'])
        else:
            values.update(last_partial_snapshot=summary['snapshot_id'], last_partial_at=now())
        save_status(values)
        if not manifest['complete']:
            raise RuntimeError('Partial backup preserved; see recovery/manifest.json and status.json')
    finally:
        try:
            run([*SSH, 'rm -rf -- ' + shlex.quote(remote)], timeout=30)
        except Exception as error:
            print('Remote temporary export cleanup deferred:', error, file=sys.stderr)
    restic('forget', '--host', 'dev', '--tag', 'complete', '--keep-hourly', '48',
           '--keep-daily', '14', '--keep-weekly', '8', '--keep-monthly', '6')
    previous = json.loads((CONFIG / 'status.json').read_text())
    last_prune = previous.get('last_prune')
    if last_prune is None or time.time() - datetime.datetime.fromisoformat(last_prune).timestamp() > 7 * 86400:
        restic('check', '--read-data')
        restic('prune')
        save_status({'last_check': now(), 'last_prune': now()})


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', default='run', choices=['run', 'status', 'snapshots', 'check', 'restore', 'prune'])
    parser.add_argument('--snapshot', default='latest')
    parser.add_argument('--target', type=Path)
    args = parser.parse_args()
    BASE.mkdir(parents=True, exist_ok=True, mode=0o700)
    CONFIG.mkdir(parents=True, exist_ok=True, mode=0o700)
    if args.action == 'status':
        print((CONFIG / 'status.json').read_text() if (CONFIG / 'status.json').exists() else 'No completed backup yet')
        return
    if args.action == 'snapshots':
        restic('snapshots', '--host', 'dev')
        return
    lock = (CONFIG / 'lock').open('a')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print('Another backup/check/restore is running; skipped')
        if args.action != 'run':
            raise SystemExit(1)
        return
    if args.action == 'run':
        try:
            backup()
        except Exception as e:
            save_status({'running': False, 'error': str(e), 'failed_at': now()})
            preserve_partial(e)
            raise
    elif args.action == 'check':
        restic('check', '--read-data')
        save_status({'last_check': now()})
    elif args.action == 'prune':
        restic('prune')
    elif args.action == 'restore':
        if args.target is None:
            parser.error('restore requires --target, a NEW recovery directory')
        target = args.target.expanduser().resolve()
        if target.exists():
            parser.error('Restore target must not exist; existing Mac configs are preserved')
        if target == BASE or BASE in target.parents or target == HOME:
            parser.error('Choose a recovery directory outside the backup repository')
        # Relative backup inputs create /home, /recovery, /resolved-skills in
        # the snapshot tree; metadata "paths" are absolute but not tree prefixes.
        restic('restore', args.snapshot, '--host', 'dev', '--tag', 'complete,managed-codex',
               '--target', target, '--verify')
        print('Restored to', target, '\nRead', target / 'recovery/RECOVERY.md')


if __name__ == '__main__':
    main()
