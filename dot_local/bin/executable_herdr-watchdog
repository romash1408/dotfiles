#!/usr/bin/env python3
"""Run the existing Herdr watchdog manually on the work Mac."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

TASK_HOME = Path.home()
PYTHON = TASK_HOME / '.local/share/dev-backup/validation-venv/bin/python3'
RUNTIME = TASK_HOME / '.local/libexec/herdr-watchdog'
CONFIG = TASK_HOME / '.config/herdr-watchdog/config.json'
SOURCE = TASK_HOME / '.agents/skills/herdr-watchdog/scripts'

if Path(sys.executable) != PYTHON:
    os.execv(str(PYTHON), [str(PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]])

if sys.argv[1:] == ['refresh']:
    RUNTIME.mkdir(parents=True, exist_ok=True)
    for name in ('watchdog.py', 'context_compaction.py', 'arc_probe.py'):
        shutil.copy2(SOURCE / name, RUNTIME / name)
    print('Watchdog runtime refreshed from the installed skill')
    raise SystemExit(0)

config = json.loads(CONFIG.read_text())
live = subprocess.run([config['herdr_bin'], 'agent', 'list'], capture_output=True,
                      text=True, check=True, timeout=10)
ops = [a for a in json.loads(live.stdout)['result']['agents']
       if a.get('name') == config['ops_name']]
if len(ops) != 1:
    raise SystemExit('Expected one live ' + config['ops_name'] + '; start Ops first')
config.update(main_workspace=ops[0]['workspace_id'], ops_pane_id=ops[0]['pane_id'])
temporary = CONFIG.with_suffix('.tmp')
temporary.write_text(json.dumps(config, ensure_ascii=False, indent=2) + '\n')
os.replace(temporary, CONFIG)
os.environ['CODEX_HOME'] = config['codex_home']
os.environ['PATH'] = str(PYTHON.parent) + os.pathsep + os.environ['PATH']
sys.path.insert(0, str(RUNTIME))
import watchdog

OriginalRunner = watchdog.Runner
class MacRunner(OriginalRunner):
    def run(self, argv, **kwargs):
        if argv[1:4] == ['agent', 'prompt', config['stable_name']] and argv[4].startswith('$herdr-watchdog'):
            # Process detection can precede OpenCode's interactive prompt.
            deadline = time.monotonic() + 20
            while True:
                screen = super().run([config['herdr_bin'], 'agent', 'read',
                                      config['stable_name'], '--source', 'visible', '--lines', '24'], timeout=5)
                if screen.returncode == 0 and 'ctrl+p cmd' in screen.stdout:
                    break
                if time.monotonic() >= deadline:
                    return watchdog.CommandResult(124, '', 'OpenCode prompt is not ready; signal was not sent')
                time.sleep(0.2)
            argv = list(argv)
            argv[4] = argv[4].replace('Собери свежий snapshot скриптом каждые 15 минут',
                                     'Собери один свежий snapshot для этого ручного прохода')
            argv[4] += ('\nРучной проход на Mac, без расписания. Выполни ровно один snapshot и полный разбор по скиллу. '
                        'Пути /home/dubiner из скилла здесь устарели. Для всех режимов скрипта используй '
                        'python3 ' + str(RUNTIME / 'watchdog.py') + '; config уже в ' + str(CONFIG) + '. '
                        'Автосжатие выключено; не включай его и не создавай таймеры. '
                        'Следующий сигнал будет только по ручному вызову, не обещай повтор через 15 минут. '
                        'Существующие разрешения и Mac resource policy агентов сохраняются.')
        return super().run(argv, **kwargs)

watchdog.Runner = MacRunner
if len(sys.argv) == 1:
    sys.argv.append('cron')
elif sys.argv[1] == 'run':
    sys.argv[1] = 'cron'
raise SystemExit(watchdog.main())
