#!/usr/bin/env python3
"""Restore required registered mounts, then gate Herdr session restoration.

Checks native session cwd values, active herdr-history records and explicit paths.
Arc prefixes remain known even when their FUSE mounts have disappeared. A local
arc probe checks only current accessibility, not future network availability.
Never create a checkout, replace an overlay, pull, or change VPN.
"""
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import time


def collect_cwds(value):
    if isinstance(value, dict):
        for key, item in value.items():
            if (key == "cwd" or key.endswith("_cwd")) and isinstance(item, str) and item:
                yield item
            elif isinstance(item, (dict, list)):
                yield from collect_cwds(item)
    elif isinstance(value, list):
        for item in value:
            yield from collect_cwds(item)


def registered_mounts(timeout):
    result = subprocess.run(
        ["arc", "mount", "--list", "--json"],
        capture_output=True, text=True, timeout=timeout, check=True,
    )
    mounts = json.loads(result.stdout)
    if not isinstance(mounts, list):
        raise RuntimeError("Arc returned an invalid mount inventory")
    return [m for m in mounts if isinstance(m, dict) and isinstance(m.get("mount"), str)]


def contains_cwd(mount, cwd):
    return cwd == mount or cwd.startswith(mount.rstrip(os.sep) + os.sep)


def restore_registered_mounts(paths, home, timeout):
    # The service and interactive guard can arrive together after login.
    lock_dir = home / ".local/state/herdr"
    lock_dir.mkdir(parents=True, exist_ok=True)
    with (lock_dir / "arc-startup.lock").open("a") as lock:
        deadline = time.monotonic() + timeout
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError("another Arc startup check is still mounting worktrees; retry")
                time.sleep(0.1)
        mounts = registered_mounts(timeout)
        needed = set()
        for cwd in paths:
            matches = [m["mount"] for m in mounts if contains_cwd(m["mount"], cwd)]
            if matches:
                needed.add(max(matches, key=len))
        for path in sorted(needed):
            entries = [m for m in mounts if m["mount"] == path]
            if len(entries) != 1:
                raise RuntimeError("ambiguous registered Arc mount: " + path)
            entry = entries[0]
            if entry.get("status") == "mounted":
                continue
            if entry.get("status") != "unmounted" or entry.get("problems"):
                raise RuntimeError("registered Arc mount needs attention: " + path)
            # Refuse an incomplete registration instead of creating a fresh checkout.
            for key in ("mount", "store", "object-store"):
                value = entry.get(key)
                if not isinstance(value, str) or not os.path.isabs(value) or value == os.sep:
                    raise RuntimeError("invalid registered Arc " + key + ": " + path)
            if not (Path(entry["store"]) / ".arc").is_dir() or not Path(entry["object-store"]).is_dir():
                raise RuntimeError("registered Arc storage is missing: " + path)
            result = subprocess.run(
                ["arc", "mount", path], capture_output=True, text=True, timeout=timeout,
            )
            if result.returncode:
                raise RuntimeError("cannot mount " + path + ": " + (result.stderr or result.stdout).strip()[-1000:])
            current = [m for m in registered_mounts(timeout) if m["mount"] == path]
            if len(current) != 1 or current[0].get("status") != "mounted" or any(
                current[0].get(key) != entry[key] for key in ("store", "object-store")
            ):
                raise RuntimeError("Arc mount did not preserve its registered storage: " + path)
            print("herdr preflight: mounted " + path, flush=True)
        return registered_mounts(timeout)


def main():
    home = Path.home()
    config = Path(os.environ.get("HERDR_ARC_PREFLIGHT_CONFIG", home / ".config/herdr/arc-preflight.json"))
    if not config.exists():
        raise RuntimeError("missing Arc preflight configuration: " + str(config))
    settings = json.loads(config.read_text())
    if not settings["enabled"]:
        return
    prefixes = [os.path.abspath(os.path.expanduser(p)) for p in settings["arc_prefixes"]]
    paths = set(settings.get("required_paths", []))
    config_dir = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config")) / "herdr"
    session_files = [config_dir / "session.json", *config_dir.glob("sessions/*/session.json")]
    for record in session_files:
        if record.exists():
            paths.update(collect_cwds(json.loads(record.read_text())))
    history = Path(os.environ.get("HERDR_HISTORY_DIR", home / ".config/herdr-history"))
    records = list(history.glob("*.yaml"))
    if records:
        # Legacy history is YAML; never silently skip it when its parser is missing.
        try:
            import yaml
        except ImportError:
            # The work Mac keeps PyYAML in the existing backup/watchdog venv.
            # launchd does not inherit the interactive shell's Python environment.
            yaml_python = home / ".local/share/dev-backup/validation-venv/bin/python3"
            if yaml_python.is_file() and Path(sys.prefix) != yaml_python.parent.parent:
                check = subprocess.run(
                    [str(yaml_python), "-c", "import yaml"],
                    capture_output=True, timeout=5,
                )
                if check.returncode == 0:
                    os.execv(str(yaml_python), [str(yaml_python), __file__, *sys.argv[1:]])
            raise RuntimeError("active history may be present but PyYAML is missing; install PyYAML before restoring")
        for record in records:
            value = yaml.safe_load(record.read_text()) or {}
            if value.get("lifecycle_state") in ("active", "archiving") and value.get("project_cwd"):
                paths.add(value["project_cwd"])
    timeout = settings.get("timeout_seconds", 20)
    if any(not os.path.isabs(item) for item in paths):
        raise RuntimeError("non-absolute saved cwd; refusing session restore")
    if paths:
        # Arc tracks custom mounts as well as ~/arcadia. Do not classify only by naming convention.
        if settings.get("mount_registered", False):
            mounts = restore_registered_mounts(paths, home, timeout)
        else:
            mounts = registered_mounts(timeout)
        prefixes.extend(os.path.abspath(mount["mount"]) for mount in mounts)
    failures = []
    arc_count = 0
    for item in sorted(paths):
        if not os.path.isabs(item):
            failures.append("non-absolute saved cwd: " + item)
            continue
        # Check every cwd in a child: a hung FUSE stat/chdir must not hang the gate forever.
        path = os.path.abspath(item)
        arc = any(path == p or path.startswith(p + os.sep) for p in prefixes)
        command = ["arc", "root"] if arc else [sys.executable, "-c", "import os; os.scandir('.').close()"]
        try:
            # Perform chdir AFTER exec, so subprocess' pre-exec error pipe cannot hang on FUSE.
            probe = "import os,sys; os.chdir(sys.argv[1]); os.execvp(sys.argv[2],sys.argv[2:])"
            result = subprocess.run([sys.executable, "-c", probe, path, *command], capture_output=True, text=True, timeout=timeout)
            if result.returncode:
                failures.append(path + ": " + (result.stderr.strip().splitlines() or ["probe failed"])[-1])
            elif arc:
                root = result.stdout.strip()
                if not root or not os.path.isabs(root) or not (path == root or path.startswith(root.rstrip("/") + "/")):
                    failures.append(path + ": unexpected arc root " + repr(root))
                else:
                    # Reading directory entries catches an unresponsive/stale mount beyond mere existence.
                    subprocess.run([sys.executable, "-c", "import os,sys; next(os.scandir(sys.argv[1]),None)", path], check=True, capture_output=True, timeout=timeout)
                    arc_count += 1
        except (OSError, subprocess.SubprocessError) as exc:
            failures.append(path + ": " + str(exc))
    if failures:
        raise RuntimeError("refusing session restore:\n" + "\n".join(failures) + "\nRestore VPN/mount access and retry; no checkout or overlay was recreated.")
    print(f"herdr preflight: checked {len(paths)} saved cwd(s), {arc_count} Arc cwd(s)")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print("herdr preflight: " + str(exc), file=sys.stderr)
        sys.exit(1)
