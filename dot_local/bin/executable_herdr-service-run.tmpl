#!/bin/sh
set -eu
export PATH="{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
{{ if eq .chezmoi.os "darwin" -}}
# Compatibility for a live job loaded from the old plist: its next restart must
# enter the private runner, not recursively demand-start itself. No live reload.
if [ "${XPC_SERVICE_NAME:-}" = local.herdr ] && [ "${PPID:-0}" = 1 ]; then
  exec "$HOME/.local/libexec/herdr-server-run"
fi
web_only=false
case "${1:-}" in
  '') ;;
  --web-only) web_only=true; parent="${2:?missing server pid}" ;;
  --help|-h) echo 'Usage: herdr-service-run'; exit 0 ;;
  *) echo 'Usage: herdr-service-run' >&2; exit 2 ;;
esac
# The plists live outside LaunchAgents: nothing starts at login. bootstrap keeps
# supervision independent of this terminal, once the user explicitly asks.
domain="gui/$(id -u)"
root="$HOME/.config/herdr/launchd"
mkdir -p "$HOME/Library/Logs"
if [ "$web_only" = false ] && ! /opt/homebrew/bin/herdr status server 2>/dev/null | grep -q 'status: running'; then
  if launchctl print "$domain/local.herdr" >/dev/null 2>&1; then
    launchctl kickstart "$domain/local.herdr"
  else
    launchctl bootstrap "$domain" "$root/local.herdr.plist"
  fi
  echo "Starting Herdr: agent updates, Arc mounts, then session restore."
  echo "Progress: $HOME/Library/Logs/herdr.log"
fi
attempt=0
until /opt/homebrew/bin/herdr status server 2>/dev/null | grep -q 'status: running'; do
    if [ "$web_only" = true ] && ! kill -0 "$parent" 2>/dev/null; then
      exit 0
    fi
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 3 ]; then
      job=$(launchctl print "$domain/local.herdr" 2>/dev/null || true)
      if ! printf '%s\n' "$job" | grep -q 'state = running' &&
         printf '%s\n' "$job" | grep -Eq 'last exit code = [1-9]'; then
        echo "Startup failed; launchd will retry. See $HOME/Library/Logs/herdr.log" >&2
        tail -n 12 "$HOME/Library/Logs/herdr.log" >&2
        exit 1
      fi
    fi
    if [ "$attempt" -ge 4500 ]; then
      echo "Herdr is not ready; see $HOME/Library/Logs/herdr.log" >&2
      exit 1
    fi
    sleep 1
done
{{ if get . "herdrWebUI" -}}
if [ ! -f "$HOME/.local/share/herdr-web-ui/current/dist/index.html" ]; then
  echo "Herdr is running; web UI needs herdr-web-update --apply." >&2
  exit 1
fi
if launchctl print "$domain/local.herdr-web-ui" >/dev/null 2>&1; then
  launchctl kickstart "$domain/local.herdr-web-ui"
else
  # The server's readiness helper and an interactive launcher may arrive together.
  launchctl bootstrap "$domain" "$root/local.herdr-web-ui.plist" 2>/dev/null || {
    launchctl print "$domain/local.herdr-web-ui" >/dev/null 2>&1 || {
      echo "Cannot load local.herdr-web-ui; see $root/local.herdr-web-ui.plist" >&2
      exit 1
    }
  }
fi
{{ end -}}
if [ "$web_only" = false ]; then
  echo "Herdr is running under launchd; this terminal may be closed."
fi
{{ else -}}
exec systemctl --user start herdr.service
{{ end -}}
