<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.dev-link</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>{{ .chezmoi.homeDir }}/.local/bin/dev-link</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>2</integer>
  <key>ExitTimeOut</key><integer>5</integer>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/dev-link.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/dev-link.log</string>
</dict></plist>
