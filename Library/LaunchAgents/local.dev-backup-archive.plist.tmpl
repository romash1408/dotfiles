<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.dev-backup-archive</string>
  <key>ProgramArguments</key><array><string>{{ .chezmoi.homeDir }}/.local/bin/dev-backup</string><string>archive</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><false/>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>15</integer>
  <key>StandardOutPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/dev-backup-archive.log</string>
  <key>StandardErrorPath</key><string>{{ .chezmoi.homeDir }}/Library/Logs/dev-backup-archive.log</string>
</dict></plist>
